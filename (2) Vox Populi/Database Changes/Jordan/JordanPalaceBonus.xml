<?xml version="1.0" encoding="utf-8"?>
<!-- Jordan: "Extra Palace Bonuses" carrier building.
     Holds the wonder-style bonuses that used to be baked directly onto BUILDING_PALACE
     (see the reverted block in City/Buildings/BuildingChanges2.sql). It is never buildable
     (Cost = -1, no PrereqTech) and is granted to each MAJOR civ's capital at runtime by
     Core Files/New Lua/JordanGameOptions.lua, but ONLY when the GAMEOPTION_EXTRA_PALACE_BONUSES
     setup checkbox is ticked. NeverCapture means it is destroyed (not transferred) if the
     capital is taken, so the bonus never leaks to a conqueror; the owner's next capital
     re-acquires it on its following turn.
       - WorkerSpeedModifier 30   -> +30% Worker build speed (player-wide, was Pyramid)
       - UnmoddedHappiness   150  -> +150 flat Happiness      (was Notre Dame, moved here)
       - Building_GlobalYieldModifiers FOOD 10 -> +10% Food in all cities (was Temple of Artemis) -->
<GameData>
	<BuildingClasses>
		<Row>
			<Type>BUILDINGCLASS_JORDAN_PALACE_BONUS</Type>
			<DefaultBuilding>BUILDING_JORDAN_PALACE_BONUS</DefaultBuilding>
			<Description>TXT_KEY_BUILDING_JORDAN_PALACE_BONUS</Description>
			<MaxGlobalInstances>-1</MaxGlobalInstances>
		</Row>
	</BuildingClasses>
	<Buildings>
		<Row>
			<Type>BUILDING_JORDAN_PALACE_BONUS</Type>
			<BuildingClass>BUILDINGCLASS_JORDAN_PALACE_BONUS</BuildingClass>
			<Cost>-1</Cost>
			<Description>TXT_KEY_BUILDING_JORDAN_PALACE_BONUS</Description>
			<Help>TXT_KEY_BUILDING_JORDAN_PALACE_BONUS_HELP</Help>
			<Civilopedia>TXT_KEY_BUILDING_JORDAN_PALACE_BONUS_HELP</Civilopedia>
			<NeverCapture>true</NeverCapture>
			<NukeImmune>true</NukeImmune>
			<MinAreaSize>-1</MinAreaSize>
			<ConquestProb>0</ConquestProb>
			<HurryCostModifier>-1</HurryCostModifier>
			<WorkerSpeedModifier>30</WorkerSpeedModifier>
			<UnmoddedHappiness>150</UnmoddedHappiness>
			<IconAtlas>BUILDING_ATLAS_VP_1</IconAtlas>
			<PortraitIndex>0</PortraitIndex>
		</Row>
	</Buildings>
	<Building_GlobalYieldModifiers>
		<Row>
			<BuildingType>BUILDING_JORDAN_PALACE_BONUS</BuildingType>
			<YieldType>YIELD_FOOD</YieldType>
			<Yield>10</Yield>
		</Row>
	</Building_GlobalYieldModifiers>
	<Language_en_US>
		<Row Tag="TXT_KEY_BUILDING_JORDAN_PALACE_BONUS">
			<Text>Capital Bonuses</Text>
		</Row>
		<Row Tag="TXT_KEY_BUILDING_JORDAN_PALACE_BONUS_HELP">
			<Text>Granted automatically to your capital while the "Extra Palace Bonuses" game option is enabled. Provides +30% Worker build speed, +150 [ICON_HAPPINESS_1] Happiness, and +10% [ICON_FOOD] Food in all of your cities.</Text>
		</Row>
	</Language_en_US>
</GameData>
